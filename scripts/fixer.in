#!/usr/bin/env bash
set -euo pipefail
REPO_ROOT="@REPO_ROOT@"
export FIXER_MCP_BINARY="${FIXER_MCP_BINARY:-@FIXER_BINARY@}"
if [[ -z "${FIXER_DB_PATH:-}" ]]; then
  FIXER_STATE_ROOT="${XDG_STATE_HOME:-${HOME}/.local/state}"
  export FIXER_DB_PATH="${FIXER_STATE_ROOT}/fixer-client-wires/fixer.db"
  mkdir -p "$(dirname "${FIXER_DB_PATH}")"
fi
exec python3 "${REPO_ROOT}/client_wires/fixer_wire.py" "$@"
